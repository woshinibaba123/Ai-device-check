        "返回我的页面并核对。"
      ],
      "status": "source_candidate",
      "parameters": [],
      "readonly": true
    },
    {
      "id": "language-switch",
      "name": "语言切换与返回",
      "readonly": false,
      "platforms": [
        "App"
      ],
      "parameters": [
        {
          "key": "language",
          "label": "目标语言",
          "default": "日语"
        }
      ],
      "sources": [
        "app:lib/services/language/language_store.dart"
      ],
      "steps": [
        "进入我的、通用设置、语言设置。",
        "选择 {{language}}，核对选中状态和页面实际文案。",
        "返回我的页面并记录结果，不退出账号。"
      ],
      "status": "source_candidate"
    }
  ]
